# ─────────────────────────────────────────────────────────────
# ตัวอย่างไฟล์ตั้งค่าบัญชีทดสอบ
#
# วิธีใช้: ก๊อปไฟล์นี้เป็น tests/e2e/.env.local แล้วใส่รหัสผ่านจริงในไฟล์นั้น
# (.env.local ถูก gitignore ไว้ จึงไม่หลุดขึ้น GitHub — ไฟล์ .env.example นี้ขึ้นได้)
#
# ถ้าตั้ง environment variable ไว้แล้ว ค่านั้นจะชนะไฟล์นี้เสมอ
# ─────────────────────────────────────────────────────────────

# ผู้ขอลาคนแรก — สมชาย ใจดี (role employee)
E2E_EMPLOYEE_EMAIL=somchai@example.com
E2E_EMPLOYEE_PASSWORD=

# ผู้อนุมัติ — สมหญิง รักงาน (role manager)
E2E_MANAGER_EMAIL=somying@example.com
E2E_MANAGER_PASSWORD=

# ผู้ขอลาคนที่สอง — ทดสอบ สอง (role employee) ใช้เฉพาะเทสต์เคสที่ 5
E2E_EMPLOYEE2_EMAIL=employee2@example.com
E2E_EMPLOYEE2_PASSWORD=
